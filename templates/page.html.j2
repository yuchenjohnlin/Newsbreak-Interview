<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ page.headline }}</title>
<style>
  :root {
    --bg: #faf9f7;
    --surface: #ffffff;
    --ink: #1a1a1a;
    --ink-soft: #555;
    --ink-faint: #8a8a8a;
    --line: #e8e5e0;
    --serif: "Iowan Old Style", Georgia, "Times New Roman", serif;
    --sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    --radius: 12px;
    --shadow: 0 1px 3px rgba(0,0,0,.05), 0 4px 16px rgba(0,0,0,.04);
  }
  .theme-tech   { --accent: #4f46e5; --accent-soft: #eef2ff; --accent-ink: #3730a3; }
  .theme-show   { --accent: #c026d3; --accent-soft: #fdf4ff; --accent-ink: #86198f; }
  .theme-sports { --accent: #059669; --accent-soft: #ecfdf5; --accent-ink: #065f46; }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #141414; --surface: #1e1e1e; --ink: #ececec; --ink-soft: #b0b0b0;
      --ink-faint: #7c7c7c; --line: #2c2c2c;
      --shadow: 0 1px 3px rgba(0,0,0,.4);
    }
    .theme-tech   { --accent: #818cf8; --accent-soft: #23244a; --accent-ink: #c7d2fe; }
    .theme-show   { --accent: #e879f9; --accent-soft: #3a1f40; --accent-ink: #f5d0fe; }
    .theme-sports { --accent: #34d399; --accent-soft: #15332a; --accent-ink: #a7f3d0; }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0; background: var(--bg); color: var(--ink);
    font-family: var(--sans); font-size: 16px; line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }
  .accent-bar { height: 5px; background: linear-gradient(90deg, var(--accent), color-mix(in srgb, var(--accent) 55%, transparent)); }
  .wrap { max-width: 880px; margin: 0 auto; padding: 0 24px 64px; }

  /* hero */
  header.hero { padding: 44px 0 0; }
  .badge {
    display: inline-block; font-size: 12px; font-weight: 700; letter-spacing: .08em;
    text-transform: uppercase; color: var(--accent-ink); background: var(--accent-soft);
    padding: 4px 12px; border-radius: 999px; margin-bottom: 16px;
  }
  h1 {
    font-family: var(--serif); font-size: clamp(30px, 5.5vw, 44px);
    line-height: 1.12; letter-spacing: -0.01em; margin: 0 0 14px;
  }
  .dek { font-size: 19px; color: var(--ink-soft); margin: 0 0 18px; line-height: 1.5; }
  .meta-row { display: flex; flex-wrap: wrap; gap: 8px 18px; font-size: 13px; color: var(--ink-faint); }
  .hero-img { margin: 22px 0 0; }
  .hero-img img { width: 100%; max-height: 420px; object-fit: cover; border-radius: var(--radius); box-shadow: var(--shadow); display: block; }
  .hero-img figcaption { font-size: 12.5px; color: var(--ink-faint); margin-top: 8px; }

  /* top-line stat band — the loudest facts, attached to the hero */
  .topline {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1px;
    background: var(--line); border: 1px solid var(--line); border-radius: var(--radius);
    overflow: hidden; margin: 26px 0 0; box-shadow: var(--shadow);
  }
  .topline .cell { background: var(--surface); padding: 16px 18px 14px; }
  .topline .value { font-family: var(--serif); font-size: 22px; font-weight: 700; line-height: 1.25; color: var(--accent-ink); }
  .topline .label { font-size: 11.5px; font-weight: 700; text-transform: uppercase; letter-spacing: .07em; color: var(--ink-faint); margin-top: 4px; }

  /* sections */
  section { margin-top: 44px; }
  h2 {
    font-size: 13px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase;
    color: var(--ink-faint); margin: 0 0 16px; display: flex; align-items: center; gap: 10px;
  }
  h2::after { content: ""; flex: 1; height: 1px; background: var(--line); }
  .summary { font-size: 18.5px; line-height: 1.65; margin: 0; font-family: var(--serif); }

  /* pull quote — the page's emotional beat */
  .pull {
    margin: 40px 0 0; padding: 6px 0 6px 26px; border-left: 4px solid var(--accent);
    position: relative;
  }
  .pull p {
    font-family: var(--serif); font-size: clamp(20px, 3vw, 26px); line-height: 1.4;
    font-style: italic; margin: 0; color: var(--ink);
  }
  .pull cite { display: block; margin-top: 10px; font-style: normal; font-size: 14px; color: var(--accent-ink); font-weight: 600; }

  /* key facts grid (the quieter details) */
  .facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 14px; }
  .fact {
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius);
    padding: 16px 18px; box-shadow: var(--shadow);
  }
  .fact .label { font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: .06em; color: var(--accent-ink); margin-bottom: 6px; }
  .fact .value { font-size: 15px; line-height: 1.5; }

  /* timeline */
  .timeline { list-style: none; margin: 0; padding: 0 0 0 6px; position: relative; }
  .timeline::before { content: ""; position: absolute; left: 11px; top: 8px; bottom: 8px; width: 2px; background: var(--line); }
  .timeline li { position: relative; padding: 0 0 26px 38px; }
  .timeline li:last-child { padding-bottom: 4px; }
  .tl-dot {
    position: absolute; left: 4px; top: 5px; width: 14px; height: 14px; border-radius: 50%;
    background: var(--accent); border: 3px solid var(--bg); box-shadow: 0 0 0 1px var(--accent);
  }
  .tl-dot.upcoming { background: var(--bg); }
  .tl-date { font-size: 13px; font-weight: 600; color: var(--accent-ink); }
  .tl-pill {
    font-size: 10.5px; font-weight: 700; text-transform: uppercase; letter-spacing: .07em;
    color: var(--accent-ink); background: var(--accent-soft); border-radius: 999px;
    padding: 2px 8px; margin-left: 8px; vertical-align: 1px;
  }
  .tl-label { font-weight: 650; margin: 2px 0; }
  .tl-desc { font-size: 14.5px; color: var(--ink-soft); margin: 0; }

  /* entities */
  .entities { display: flex; flex-wrap: wrap; gap: 10px; }
  .entity {
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius);
    padding: 10px 14px; font-size: 14px; box-shadow: var(--shadow);
  }
  .entity b { display: block; font-size: 14.5px; }
  .entity .role { color: var(--accent-ink); font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: .05em; }
  .entity .desc { color: var(--ink-soft); font-size: 13px; max-width: 380px; }

  /* extras card */
  .panel {
    background: var(--surface); border: 1px solid var(--line); border-left: 4px solid var(--accent);
    border-radius: var(--radius); padding: 20px 22px; box-shadow: var(--shadow);
  }
  .panel + .panel { margin-top: 14px; }
  .panel h3 { margin: 0 0 10px; font-size: 16px; }
  .kv { display: grid; grid-template-columns: 150px 1fr; gap: 8px 16px; font-size: 14.5px; }
  .kv dt { color: var(--ink-faint); font-weight: 600; }
  .kv dd { margin: 0; }
  table.matches { width: 100%; border-collapse: collapse; font-size: 14.5px; }
  table.matches th { text-align: left; font-size: 12px; text-transform: uppercase; letter-spacing: .06em; color: var(--ink-faint); padding: 6px 10px; border-bottom: 1px solid var(--line); }
  table.matches td { padding: 9px 10px; border-bottom: 1px solid var(--line); }
  table.matches tr:last-child td { border-bottom: 0; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 6px; }
  .chip { background: var(--accent-soft); color: var(--accent-ink); border-radius: 999px; padding: 3px 12px; font-size: 13px; font-weight: 600; }
  blockquote.reaction { margin: 0 0 12px; padding: 0 0 0 14px; border-left: 3px solid var(--line); }
  blockquote.reaction p { margin: 0; font-size: 15px; }
  blockquote.reaction cite { font-size: 13px; color: var(--ink-faint); font-style: normal; }

  /* closing coda: the story's ending, side by side */
  .coda { display: grid; grid-template-columns: 1.2fr 1fr; gap: 16px; }
  .coda .matters {
    font-size: 16.5px; line-height: 1.65; background: var(--accent-soft);
    border-radius: var(--radius); padding: 20px 24px; margin: 0; color: var(--ink);
  }
  .coda .watch {
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius);
    padding: 18px 22px; box-shadow: var(--shadow);
  }
  .coda .watch h3 { margin: 0 0 10px; font-size: 13px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--ink-faint); }
  ul.next { margin: 0; padding-left: 20px; font-size: 14.5px; }
  ul.next li { margin-bottom: 8px; }

  /* sources */
  ol.sources { margin: 0; padding-left: 24px; font-size: 14px; }
  ol.sources li { margin-bottom: 9px; }
  ol.sources a { color: var(--accent-ink); text-decoration: none; }
  ol.sources a:hover { text-decoration: underline; }
  .src-meta { color: var(--ink-faint); font-size: 13px; }
  sup.cite { font-size: 11px; }
  sup.cite a { color: var(--accent-ink); text-decoration: none; font-weight: 600; }

  footer {
    margin-top: 56px; padding-top: 18px; border-top: 1px solid var(--line);
    font-size: 12.5px; color: var(--ink-faint); line-height: 1.7;
  }
  .freshness { margin-top: 28px; font-size: 13px; color: var(--ink-faint); background: var(--surface); border: 1px dashed var(--line); border-radius: 8px; padding: 10px 14px; }

  @media (max-width: 560px) {
    .kv { grid-template-columns: 1fr; gap: 2px 0; }
    .kv dt { margin-top: 8px; }
    header.hero { padding-top: 30px; }
    .coda { grid-template-columns: 1fr; }
  }
</style>
</head>
{% macro cite(ids) %}
{%- if ids -%}
<sup class="cite">{% for i in ids %}<a href="#src-{{ i }}">[{{ i }}]</a>{% endfor %}</sup>
{%- endif -%}
{% endmacro %}
{# Partition facts: up to 3 short ones become the loud top-line band; the rest
   stay in the detail grid. Synthesis orders facts most-newsworthy-first. #}
{% set ns = namespace(band=[], grid=[], pull=none, talk=[]) %}
{% for f in page.key_facts %}
  {% if f.value|length <= 64 and ns.band|length < 3 %}{% set ns.band = ns.band + [f] %}
  {% else %}{% set ns.grid = ns.grid + [f] %}{% endif %}
{% endfor %}
{# First punchy reaction becomes the pull quote; the rest are the conversation. #}
{% for r in page.reactions %}
  {% if ns.pull is none and r.take|length <= 220 %}{% set ns.pull = r %}
  {% else %}{% set ns.talk = ns.talk + [r] %}{% endif %}
{% endfor %}
<body class="theme-{{ page.category }}">
<div class="accent-bar"></div>
<div class="wrap">

  <header class="hero">
    <span class="badge">
      {% if page.category == "tech" %}Tech · Product launch
      {% elif page.category == "show" %}Culture · Live event
      {% else %}Sports · Tournament{% endif %}
    </span>
    <h1>{{ page.headline }}</h1>
    <p class="dek">{{ page.dek }}</p>
    <div class="meta-row">
      <span>Topic page · generated {{ page.generated_at | fmt_date }}</span>
      <span>{{ page.sources | length }} sources</span>
    </div>
    {% if page.hero_image %}
    <figure class="hero-img">
      <img src="{{ page.hero_image.url }}" alt="{{ page.hero_image.caption or page.headline }}"
           loading="lazy" onerror="this.parentElement.style.display='none'">
      {% if page.hero_image.caption %}
      <figcaption>{{ page.hero_image.caption }}{% if page.hero_image.credit_source_id %}<sup class="cite"><a href="#src-{{ page.hero_image.credit_source_id }}">[{{ page.hero_image.credit_source_id }}]</a></sup>{% endif %}</figcaption>
      {% endif %}
    </figure>
    {% endif %}
    {% if ns.band %}
    <div class="topline">
      {% for f in ns.band %}
      <div class="cell">
        <div class="value">{{ f.value }}{{ cite(f.source_ids) }}</div>
        <div class="label">{{ f.label }}</div>
      </div>
      {% endfor %}
    </div>
    {% endif %}
  </header>

  <section>
    <h2>Where things stand</h2>
    <p class="summary">{{ page.summary }}</p>
    {% if ns.pull %}
    <div class="pull">
      <p>“{{ ns.pull.take }}”{{ cite(ns.pull.source_ids) }}</p>
      <cite>— {{ ns.pull.source }}</cite>
    </div>
    {% endif %}
  </section>

  <section>
    <h2>How it unfolded</h2>
    <ul class="timeline">
      {% for t in page.timeline %}
      <li>
        <span class="tl-dot{% if t.status == 'upcoming' %} upcoming{% endif %}"></span>
        <span class="tl-date">{{ t.date | fmt_date }}</span>
        {% if t.status == "upcoming" %}<span class="tl-pill">Upcoming</span>{% endif %}
        <div class="tl-label">{{ t.label }}{{ cite(t.source_ids) }}</div>
        {% if t.description %}<p class="tl-desc">{{ t.description }}</p>{% endif %}
      </li>
      {% endfor %}
    </ul>
  </section>

  {% if ns.grid %}
  <section>
    <h2>The details</h2>
    <div class="facts">
      {% for f in ns.grid %}
      <div class="fact">
        <div class="label">{{ f.label }}</div>
        <div class="value">{{ f.value }}{{ cite(f.source_ids) }}</div>
      </div>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  {# ---- category-specific block ---- #}
  {% set x = page.extras %}
  {% if page.category == "tech" %}
  <section>
    <h2>The rollout</h2>
    <div class="panel">
      <dl class="kv">
        <dt>Product</dt><dd>{{ x.product }}</dd>
        <dt>Company</dt><dd>{{ x.company }}</dd>
        <dt>Availability</dt><dd>{{ x.rollout_status }}</dd>
      </dl>
    </div>
    {% if x.benchmarks_or_specs %}
    <div class="panel">
      <h3>By the numbers</h3>
      <dl class="kv">
        {% for b in x.benchmarks_or_specs %}
        <dt>{{ b.label }}</dt><dd>{{ b.value }}{{ cite(b.source_ids) }}</dd>
        {% endfor %}
      </dl>
    </div>
    {% endif %}
  </section>

  {% elif page.category == "show" %}
  <section>
    <h2>The event</h2>
    <div class="panel">
      <dl class="kv">
        <dt>Venue</dt><dd>{{ x.venue }}</dd>
        <dt>Dates</dt><dd>{{ x.dates }}</dd>
        {% if x.results %}<dt>Result</dt><dd>{{ x.results }}</dd>{% endif %}
        {% if x.how_to_watch %}<dt>How to watch</dt><dd>{{ x.how_to_watch }}</dd>{% endif %}
      </dl>
      {% if x.lineup_or_participants %}
      <h3 style="margin-top:16px">Lineup &amp; participants</h3>
      <div class="chips">
        {% for p in x.lineup_or_participants %}<span class="chip">{{ p }}</span>{% endfor %}
      </div>
      {% endif %}
    </div>
  </section>

  {% else %}
  <section>
    <h2>The tournament</h2>
    <div class="panel">
      <dl class="kv">
        <dt>Format</dt><dd>{{ x.format_summary }}</dd>
        {% if x.standings_or_results %}<dt>So far</dt><dd>{{ x.standings_or_results }}</dd>{% endif %}
        {% if x.how_to_watch %}<dt>How to watch</dt><dd>{{ x.how_to_watch }}</dd>{% endif %}
      </dl>
    </div>
    {% if x.key_matches %}
    <div class="panel">
      <h3>Key matches</h3>
      <table class="matches">
        <thead><tr><th>Date</th><th>Match</th><th>Venue</th><th>Result</th></tr></thead>
        <tbody>
          {% for m in x.key_matches %}
          <tr>
            <td>{{ m.date | fmt_date }}</td>
            <td>{{ m.teams }}</td>
            <td>{{ m.venue or "—" }}</td>
            <td>{{ m.result or "—" }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% endif %}
  </section>
  {% endif %}

  {% if page.entities %}
  <section>
    <h2>Who's involved</h2>
    <div class="entities">
      {% for e in page.entities %}
      <div class="entity">
        <span class="role">{{ e.role }}</span>
        <b>{{ e.name }}</b>
        {% if e.description %}<span class="desc">{{ e.description }}</span>{% endif %}
      </div>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  {% if ns.talk %}
  <section>
    <h2>The conversation</h2>
    <div class="panel">
      {% for r in ns.talk %}
      <blockquote class="reaction">
        <p>{{ r.take }}{{ cite(r.source_ids) }}</p>
        <cite>— {{ r.source }}</cite>
      </blockquote>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  <section>
    <h2>The bigger picture</h2>
    <div class="coda">
      <p class="matters">{{ page.why_it_matters }}</p>
      {% if page.whats_next %}
      <div class="watch">
        <h3>What to watch</h3>
        <ul class="next">
          {% for n in page.whats_next %}<li>{{ n }}</li>{% endfor %}
        </ul>
      </div>
      {% endif %}
    </div>
  </section>

  <section>
    <h2>Sources</h2>
    <ol class="sources">
      {% for s in page.sources %}
      <li id="src-{{ s.id }}">
        <a href="{{ s.url }}" target="_blank" rel="noopener">{{ s.title or s.url }}</a>
        <span class="src-meta">{{ s.sitename or (s.url | domain) }}{% if s.date %} · {{ s.date | fmt_date }}{% endif %}</span>
      </li>
      {% endfor %}
    </ol>
    {% if page.freshness_note %}
    <div class="freshness">⏱ {{ page.freshness_note }}</div>
    {% endif %}
  </section>

  <footer>
    Generated from the input sentence “{{ page.input_sentence }}” · {{ page.generated_at | fmt_date }}
    · schema v{{ page.schema_version }} · All claims cite the numbered sources above.
  </footer>

</div>
</body>
</html>
